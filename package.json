{
  "name": "pixel-art-mcp",
  "version": "0.1.0",
  "description": "MCP server for creating indexed-color pixel art (sprites, characters, tilesets, effects, icons) as PNG files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidkim9/pixel-art-mcp.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "pixel-art-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "pixel-art",
    "sprites",
    "tileset",
    "aseprite"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "ase-parser": "^0.0.19",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
